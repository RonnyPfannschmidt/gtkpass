using Gtk 4.0;
using Adw 1;

// Renaming and moving, which are one operation: an entry's name is its path,
// so "email/work" becoming "archive/email/work" is a rename that happens to
// cross a folder. Offering them as two commands would mean two dialogs
// collecting the same string.
//
// The store is shown and not chosen. Moving between backends is a decrypt and
// a re-encrypt through two different key sets rather than a move, and the
// backend contract has no operation for it, so this dialog does not pretend
// to offer one.
template $PasswordRenameDialog : Adw.Dialog {
  title: _("Rename Password");
  content-width: 480;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button cancel_button {
        label: _("Cancel");
        clicked => $_on_cancel();
      }

      [end]
      Button rename_button {
        label: _("Rename");
        clicked => $_on_rename();

        styles ["suggested-action"]
      }
    }

    content: Adw.PreferencesPage {
      Adw.PreferencesGroup {
        Adw.ActionRow store_row {
          title: _("Store");
        }

        // As in the add dialog, the row itself goes red and says why, rather
        // than an error label that appears and shifts what is under it.
        Adw.EntryRow name_row {
          title: _("Name");
          changed => $_on_name_changed();
          entry-activated => $_on_rename();
        }
      }

      Adw.PreferencesGroup {
        description: _("A name with slashes in it is a path: the folders on the way are made, and the ones the entry leaves behind go when they are empty.");
      }
    };
  };
}
