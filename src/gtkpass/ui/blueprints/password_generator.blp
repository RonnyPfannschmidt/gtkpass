using Gtk 4.0;
using Adw 1;

// The generator rows, which the add dialog, the edit dialog and the rotation
// wizard all show. One widget rather than three copies: they offer the same
// choice, and three copies of a choice drift until two of them are wrong.
//
// The rows are declared and the values are not. The scheme list, the bounds on
// the size and the entropy line all come from gtkpass.utils.generate, which is
// where the schemes are defined -- a scheme added there has to appear here
// without this file being touched, or the two definitions are two definitions.
template $PasswordGeneratorGroup : Adw.PreferencesGroup {
  title: _("Generated Passwords");

  [header-suffix]
  Button generate_button {
    label: _("Generate");
    valign: center;
    tooltip-text: _("Generate a password and put it in the field above");
    clicked => $_on_generate();

    styles ["flat"]
  }

  Adw.ComboRow scheme_row {
    title: _("Scheme");
    notify::selected => $_on_scheme_changed();
  }

  // The title, the bounds and the step all change with the scheme, because the
  // number means something different for each: characters, words, digits.
  Adw.SpinRow size_row {
    title: _("Length");

    adjustment: Adjustment {
      step-increment: 1;
      page-increment: 4;
    };

    notify::value => $_on_size_changed();
  }

  // Only one scheme has punctuation to allow, so this is hidden for the other
  // two rather than shown doing nothing.
  Adw.SwitchRow symbols_row {
    title: _("Include Symbols");
    subtitle: _("Some sites refuse them");
    active: true;
    notify::active => $_on_size_changed();
  }
}
